# =============================================================================
# Gateway (Caddy reverse proxy — TLS + routing). Consumed by docker-compose.yml
# and realtime/reverse-proxy/Caddyfile, NOT by Laravel.
# =============================================================================
# Your single public domain. Caddy terminates HTTPS for it and routes:
#   /connection/* -> centrifugo   |   everything else -> meow-app
# Must match API_BASE_URL / CENTRIFUGO_WSS used when building the mobile app.
APP_DOMAIN=your-domain.com
# Email for Let's Encrypt certificate notices (expiry / issues).
ACME_EMAIL=admin@your-domain.com

# =============================================================================
# Cache / Redis (REQUIRED — the worker + Octane stack depends on a Redis service)
# =============================================================================
# The default cache store is now `redis` (config/cache.php). Cache::lock() and the
# scheduler's withoutOverlapping() guards must coordinate across every Octane worker
# AND the jobs container — that only works with a shared store, so Redis is required.
# Every deploy MUST provide a reachable Redis. In the swarm stack REDIS_HOST is the
# host/service the containers can reach (build/migrate use 172.17.0.1).
#   - If a client deploy genuinely has NO Redis, set CACHE_DRIVER=file in that .env to
#     keep the old behaviour (single-host locks only — multi-worker guards will NOT hold).
CACHE_DRIVER=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_CACHE_DB=1
# FairLuck money vault — isolated, persistent Redis (noeviction + AOF). swarm service:
REDIS_FAIRLUCK_HOST=redis-fairluck
REDIS_FAIRLUCK_PORT=6379
REDIS_FAIRLUCK_DB=0

# =============================================================================
# Realtime / Broadcast configuration
# =============================================================================
# Live chat, gifts, and out-of-room banners run over Centrifugo (WebSocket).
# Fill in the CENTRIFUGO_* secrets below, then bring up the `centrifugo` service.
# See docs/INSTALL-*.md -> "Realtime server" for the full step-by-step.

# -----------------------------------------------------------------------------
# Broadcast driver (Laravel)
# -----------------------------------------------------------------------------
# The active realtime transport. Keep `centrifugo`.
BROADCAST_DRIVER=centrifugo

# -----------------------------------------------------------------------------
# Centrifugo (realtime transport)
# -----------------------------------------------------------------------------
# SINGLE SOURCE OF TRUTH for the Centrifugo secrets. The SAME values are injected
# into the Centrifugo node at container start: entrypoint.sh renders
# realtime/centrifugo/config.template.json into the live config using these vars.
# Laravel and the node MUST share identical values per key, or auth/proxy breaks.
# Generate each secret ONCE with:  openssl rand -hex 32
#
# Base URL of the Centrifugo HTTP API, e.g. http://centrifugo:8000/api
# (Laravel -> Centrifugo publish; internal docker network address, NOT public.)
CENTRIFUGO_API_URL=http://centrifugo:8000/api
# Redis address the Centrifugo NODE uses for its engine (history/presence/pub-sub).
# Docker service name + port. Must point at the SAME redis service as the app.
#   -> node config.json: engine.redis.address
CENTRIFUGO_REDIS_ADDRESS=redis:6379
# Password for that Redis (leave blank if your redis has no password — the default).
#   -> node config.json: engine.redis.password
CENTRIFUGO_REDIS_PASSWORD=
# Base URL of the Laravel proxy the Centrifugo NODE calls for auth (connect/subscribe
# /refresh). Internal docker address of meow-app + /api. NOT public.
#   -> node config.json: proxies[].endpoint  (=> $LARAVEL_PROXY_BASE_URL/centrifugo/connect ...)
LARAVEL_PROXY_BASE_URL=http://meow-app:8000/api
# Browser origins allowed to open the WebSocket. The mobile app sends no Origin
# header so it is unaffected; set this to your web domain.
#   -> node config.json: client.allowed_origins
CENTRIFUGO_CLIENT_ALLOWED_ORIGINS=https://your-domain.com
# API key sent as the X-API-Key header.
# (Secret Manager: centrifugo-api-key)  ->  node config.json: http_api.key
CENTRIFUGO_API_KEY=
# ONE HMAC secret (HS256) signs BOTH the connection JWT and the 1:1 subscription
# tokens. The node verifies both with the same secret: client.token.hmac_secret_key
# (subscription_token inherits it — Centrifugo v6 default, no separate block).
# (Secret Manager: centrifugo-token-hmac)  ->  node config.json: client.token.hmac_secret_key
CENTRIFUGO_HMAC_SECRET=
# Shared secret the Centrifugo node sends on its subscribe-proxy call so Laravel
# (VerifyCentrifugoProxy) can verify the request came from the node.
# (Secret Manager: centrifugo-proxy-secret)  ->  node config.json: http_proxy.static_http_headers["X-Centrifugo-Proxy-Secret"]
CENTRIFUGO_PROXY_SECRET=
# Header name the node carries CENTRIFUGO_PROXY_SECRET in. MUST equal the static
# header key in the node config.json (X-Centrifugo-Proxy-Secret).
CENTRIFUGO_PROXY_SECRET_HEADER=X-Centrifugo-Proxy-Secret
# Connection / subscription JWT lifetime in seconds (centrifuge-dart refreshes
# the connection token before exp).
CENTRIFUGO_TOKEN_TTL=3600
CENTRIFUGO_SUBSCRIPTION_TTL=3600
# Synchronous publish HTTP timeout in seconds (keep low so a slow Centrifugo
# never stalls the request that triggered the broadcast).
CENTRIFUGO_HTTP_TIMEOUT=3
# TLS verification for the API call (set false only for local self-signed dev).
CENTRIFUGO_HTTP_VERIFY=true

# =============================================================================
# WHITE-LABEL — per-app identity / endpoints / storage
# =============================================================================
# These are the per-deploy values that used to be hardcoded foreign-app literals.
# Resolution order at every consumer: DB setting (admin "App / White-Label
# Settings" page)  ->  the env var below  ->  EMPTY/null. The DB setting wins, so
# a clone can rebrand entirely from the admin panel; these env vars are only the
# fallback when the corresponding settings row is left blank.
#
# RAW per-deploy SECRETS (DB password, APP_KEY, Centrifugo HMAC, Stripe / Firebase
# SA for non-GCS) STAY in .env and are NOT moved to the DB.

# --- Identity ---
APP_ORIGIN_NAME=
GOOGLE_CLIENT_ID=
# UTD X-Encrypt header validation (also the AES-256-CBC shared secret).
UTD_CLIENT_ID=
UTD_SECRET_KEY=
# --- Payments ---
# Android package name for Google Play IAP verification (per-app; set from panel).
GOOGLE_PLAY_PACKAGE_NAME=
# NowPayments IPN callback (falls back to url('/api/now-payments-callback')).
NOWPAYMENTS_CALLBACK_URL=
# CodaPay (api_key/base_url/project_id can also be set per-app via admin DB settings,
# which override these env vars at runtime). Leave api_key blank to disable the gateway.
CODAPAY_API_KEY=
CODAPAY_BASE_URL=
CODAPAY_PROJECT_ID=
# ZiniPay (crypto gateway). api_key/url can also be set per-app via admin DB
# settings, which override these env vars at runtime. Leave api_key blank to
# disable the gateway.
ZINIPAY_API_KEY=
ZINIPAY_URL=
# CashFree (INR gateway). app_id/secret_key/mode can also be set per-app via
# admin DB settings, which override these env vars at runtime. mode = test|live.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_MODE=test

# --- Firebase / FCM ---
SENDER_ID=
FIREBASE_PROJECT_NAME=
FIREBASE_DATABASE_URI=
APP_LOGO=

# --- Media ---
# UTD media-analyze endpoint (mp4 type detection). Empty => step skipped.
UTD_MEDIA_ANALYZE_URL=

# --- Domains (env-ONLY, never DB) ---
# Comma-separated CORS origins, e.g. https://yourapp.com,https://event.yourapp.com
CORS_ALLOWED_ORIGINS=
# Session cookie domain, e.g. .yourapp.com  (blank => host-only cookie)
SESSION_DOMAIN=

# --- WhatsApp Auth (Modules/WhatsappAuth) ---
# Verification-code + token-login endpoints. Empty => WhatsApp auth not configured.
# Set these per-deployment to the real provider endpoints; defaults are blank.
WHATSAPP_SERVER_URL=
WHATSAPP_SERVER_URL_LOGIN=
WHATSAPP_USERNAME=
WHATSAPP_PASSWORD=
WHATSAPP_TOKEN=
WHATSAPP_BASE_URL=

# --- Storage (Google Cloud Storage) ---
# Preferred: set gcs_service_account_json / gcs_bucket / gcs_project_id in the
# admin White-Label page (no key file on disk). These env vars are the fallback.
GOOGLE_CLOUD_KEY_FILE=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_STORAGE_BUCKET=

# --- Storage (driver switch: GCS <-> S3) ---
# Media storage driver for the 12 media disks (public/admin/rooms/profile/...).
# 'gcs' (default) = Google Cloud Storage. 's3' = Amazon S3 (fill AWS_* below).
# Switching to s3 also requires the S3 Flysystem adapter to be installed:
#   composer require league/flysystem-aws-s3-v3 "^3.0"
MEDIA_STORAGE_DRIVER=gcs
# AWS S3 (used when MEDIA_STORAGE_DRIVER=s3). Also set storage_url in the admin panel.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
