{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-openssl": "*",
        "carlos-meneses/laravel-mpdf": "^2.1",
        "encore/laravel-admin": "^1.8",
        "fakerphp/faker": "^1.23",
        "firebase/php-jwt": "^6.9 ",
        "fruitcake/laravel-cors": "dev-develop",
        "google/apiclient": "2.15.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "imdhemy/google-play-billing": "^1.5.1",
        "intervention/image": "^2.1",
        "kreait/firebase-php": "^7.19",
        "kreait/laravel-firebase": "^5.10",
        "laravel-admin-ext/grid-sortable": "*",
        "laravel-admin-ext/helpers": "2.*",
        "laravel-admin-ext/log-viewer": "^1.0",
        "laravel-admin-extensions/multi-language": "^0.0.6",
        "laravel/framework": "^10.0",
        "laravel/nightwatch": "^1.24",
        "laravel/octane": "^2.0",
        "laravel/sanctum": "^3.3.3",
        "laravel/tinker": "^2.5",
        "league/flysystem-aws-s3-v3": "^3.0",
        "maatwebsite/excel": "^3.1",
        "mockery/mockery": "^1.6",
        "nwidart/laravel-modules": "8.0",
        "pbmedia/laravel-ffmpeg": "^8.1",
        "phpunit/phpunit": "^10.4",
        "predis/predis": "^2.2",
        "spatie/laravel-google-cloud-storage": "^2.2",
        "spatie/laravel-translatable": "^6.11",
        "stripe/stripe-php": "^9.9"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.15.4",
        "laravel/telescope": "^5.12",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Modules\\": "Modules/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/helpers.php",
            "app/helper/helpers.php",
            "app/helper/helperType.php",
            "app/Helpers/UserCoinLogHelper.php"

        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-install-cmd": [
            "@php scripts/patch-nwidart-helpers.php"
        ],
        "post-update-cmd": [
            "@php scripts/patch-nwidart-helpers.php",
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "pre-autoload-dump": "Google\\Task\\Composer::cleanup",
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "helper": [
            "@php artisan clear-compiled",
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:model --dir=\"App/Models\" --dir=\"Modules/*/Entities\""
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/telescope",
                "barryvdh/laravel-debugbar"
            ]
        },
        "google/apiclient-services": [
            "AndroidPublisher"
        ]
    },
    "config": {
         "audit": {
            "block-insecure": false
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.2.21"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
